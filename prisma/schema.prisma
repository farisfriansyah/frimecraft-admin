// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Nilai URL sengaja dikosongkan dari schema karena sudah diatur secara terpusat oleh prisma.config.ts
}

// ==================== RBAC Models ====================

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique // Contoh: "ADMIN", "USER"
  description String?

  permissions Permission[] @relation("RolePermissions")
  users       User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          Int     @id @default(autoincrement())
  name        String  @unique // Contoh: "portfolio.create", "all"
  description String?

  roles Role[] @relation("RolePermissions")

  createdAt DateTime @default(now())

  @@map("permissions")
}

// ==================== Existing Models ====================

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String
  name     String?
  avatar   String?

  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  isActive  Boolean   @default(true)
  lastLogin DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  workExperiences WorkExperience[]
  educations      Education[]
  skills          Skill[]
  languages       Language[]
  certifications  Certification[]
  portfolios      Portfolio[]
  articles        Article[]

  @@map("users")
}

// prisma/schema.prisma
model WorkExperience {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  position String // Jabatan / Nama Bagian
  location String? // Lokasi (optional)
  slug     String?

  startMonth Int // 1 - 12
  startYear  Int
  endMonth   Int? // null jika masih bekerja
  endYear    Int? // null jika masih bekerja

  isCurrent Boolean @default(false)

  description String?  @db.Text // Rich text
  tags        String[] @default([])

  // SEO Fields
  seoTitle       String?
  seoDescription String?
  keywords       String? // comma-separated

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("work_experiences")
}

model Education {
  id          Int       @id @default(autoincrement())
  userId      Int
  institution String
  degree      String?
  slug        String?
  startDate   DateTime?
  endDate     DateTime?
  description String?

  user User @relation(fields: [userId], references: [id])

  // SEO Fields
  seoTitle       String?
  seoDescription String?
  keywords       String? // comma-separated
  tags           String? // comma-separated

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("educations")
}

model Skill {
  id     Int     @id @default(autoincrement())
  userId Int
  name   String
  slug   String?
  level  Int? // 0-100
  notes  String?

  user User @relation(fields: [userId], references: [id])

  // SEO Fields
  seoTitle       String?
  seoDescription String?
  keywords       String? // comma-separated
  tags           String? // comma-separated

  @@map("skills")
}

model Language {
  id          Int     @id @default(autoincrement())
  userId      Int
  name        String
  slug        String?
  proficiency String?

  user User @relation(fields: [userId], references: [id])

  // SEO Fields
  seoTitle       String?
  seoDescription String?
  keywords       String? // comma-separated
  tags           String? // comma-separated

  @@map("languages")
}

model Certification {
  id        Int       @id @default(autoincrement())
  userId    Int
  title     String
  slug      String?
  issuer    String?
  issueDate DateTime?
  url       String?

  user User @relation(fields: [userId], references: [id])

  // SEO Fields
  seoTitle       String?
  seoDescription String?
  keywords       String? // comma-separated
  tags           String? // comma-separated

  @@map("certifications")
}

model Portfolio {
  id          Int     @id @default(autoincrement())
  title       String
  slug        String?
  description String? @db.Text
  imageUrl    String?
  projectUrl  String?
  workForId   Int?
  workAtId    Int?
  tags        String?
  featured    Boolean @default(false)
  isDisabled  Boolean @default(false)

  // SEO Fields
  seoTitle       String?
  seoDescription String?
  keywords       String? // comma-separated

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workFor Company? @relation("PortfolioWorkFor", fields: [workForId], references: [id])
  workAt  Company? @relation("PortfolioWorkAt", fields: [workAtId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("portfolios")
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  logoUrl   String?
  website   String?
  createdAt DateTime @default(now())

  portfoliosAsClient   Portfolio[]      @relation("PortfolioWorkFor")
  portfoliosAsEmployer Portfolio[]      @relation("PortfolioWorkAt")
  // TAMBAHKAN BARIS INI:
  workExperiences      WorkExperience[]

  @@map("companies")
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  excerpt   String?  @db.Text
  content   String   @db.Text
  featuredImage String? // Featured image URL
  isPublished Boolean @default(false)

  // SEO Fields
  seoTitle    String?
  seoDescription String?
  keywords    String? // comma-separated
  tags        String? // comma-separated

  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("articles")
}

model SecurityAuditLog {
  id        Int      @id @default(autoincrement())
  event     String
  status    String
  route     String
  method    String
  actorId   Int?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([event])
  @@index([status])
  @@index([actorId])
  @@map("security_audit_logs")
}

model FrontendSetting {
  id             Int      @id @default(autoincrement())
  key            String   @unique @default("default")
  siteTitle      String?
  siteDescription String?
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  canonicalUrl   String?
  ogImageUrl     String?
  footerText     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("frontend_settings")
}
